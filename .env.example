DATABASE_URL=postgres://user:password@localhost:5432/make_the_one
MODEL_API_KEY=
META_ALLOW_12=0
POSTGRES_USER=user
POSTGRES_DB=make_the_one
POSTGRES_PASSWORD=
# Required in production: independent random secret, at least 32 characters.
GENERATION_SECRET=
GENERATION_PER_10_MINUTES=3
GENERATION_CONCURRENCY=2
GENERATION_DAILY_REQUESTS=100
GENERATION_DAILY_ATTEMPTS=200
# USD 10,000,000 micro-units = $10/day. Reservations include retries/fallbacks.
GENERATION_DAILY_BUDGET_MICROUSD=10000000
# Canonical HTTPS origin required in production, e.g. https://example.com
APP_ORIGIN=
# Production only: the proxy MUST replace the selected IP header and inject this private token.
# Supported: cf-connecting-ip, x-real-ip, fly-client-ip. Never forward caller-supplied values.
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_TOKEN=
